# pikope.com docroot = public_html (index.html + assets/ = landing zip layout).
# adminnew docroot = public_html/public
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# Block backend/app source on the main domain.
RewriteRule ^(public|src|bin|app|adminnew|site-pikope.com|sql|deploy|releases|scripts|\.git)(/|$) - [F,L]
RewriteRule \.(env|md|gitignore|example)$ - [F,L,NC]
